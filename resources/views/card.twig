<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#04302A">
  <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate, max-age=0">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
  <title>{{ card.displayName ?: (card.firstName ~ ' ' ~ card.lastName) }} – {{ card.company }}</title>
  <link rel="stylesheet" href="{{ plugin_path('DigitalBusinessCard') }}/css/card.css?v=1.0.11">
</head>
<body>
{% set headerLogo = config('DigitalBusinessCard.design.headerLogo') %}
{% set brandSlots = [
  {'logo': config('DigitalBusinessCard.design.brand1Logo'), 'name': config('DigitalBusinessCard.design.brand1Name'), 'url': config('DigitalBusinessCard.design.brand1Url')},
  {'logo': config('DigitalBusinessCard.design.brand3Logo'), 'name': config('DigitalBusinessCard.design.brand3Name'), 'url': config('DigitalBusinessCard.design.brand3Url')},
  {'logo': config('DigitalBusinessCard.design.brand4Logo'), 'name': config('DigitalBusinessCard.design.brand4Name'), 'url': config('DigitalBusinessCard.design.brand4Url')}
] %}
<main class="dbc-shell">
  <section class="dbc-card">
    <div class="dbc-content">
      {% if headerLogo %}
        <img class="dbc-main-logo" src="{{ headerLogo }}" alt="{{ card.company }}">
      {% elseif card.logoUrl %}
        <img class="dbc-main-logo" src="{{ card.logoUrl }}" alt="{{ card.company }}">
      {% else %}
        <div class="dbc-logo-placeholder">{{ card.company }}</div>
      {% endif %}

      <h1>{{ card.displayName ?: (card.firstName ~ ' ' ~ card.lastName) }}</h1>
      <p class="dbc-role">{{ card.position }}{% if card.position and card.company %}<br>{% endif %}{{ card.company }}</p>
      <div class="dbc-gold-line dbc-gold-line-short"></div>

      <a class="dbc-save" href="/visitenkarte/{{ card.slug }}/kontakt.vcf" download>
        <span class="dbc-save-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" role="img"><rect x="8" y="5" width="32" height="38" rx="4"></rect><circle cx="24" cy="18" r="6"></circle><path d="M14.5 35c1.5-6 5.3-9 9.5-9s8 3 9.5 9"></path></svg>
        </span>
        <span>Kontakt speichern</span>
      </a>

      <div class="dbc-actions">
        <a href="tel:{{ card.phone|replace({' ': '', '/':'', '(':'', ')':''}) }}" class="dbc-action" aria-label="Anrufen">
          <span class="dbc-round" aria-hidden="true">
            <svg viewBox="0 0 32 32"><path d="M8.2 3.8 12.5 3l2.8 7-3.2 2.2c1.8 3.7 4.9 6.8 8.6 8.6l2.2-3.2 7 2.8-.8 4.3c-.4 2.2-2.4 3.8-4.7 3.6C13.5 27.4 4.6 18.5 3.7 7.6 3.5 5.3 5.1 4.2 8.2 3.8Z"/></svg>
          </span><span>Anrufen</span>
        </a>
        <a href="mailto:{{ card.email }}" class="dbc-action" aria-label="E-Mail">
          <span class="dbc-round" aria-hidden="true">
            <svg viewBox="0 0 32 32"><rect x="3.5" y="6.5" width="25" height="19" rx="1"/><path d="M4.5 8 16 17.2 27.5 8"/><path d="M4.5 24 12.8 15.4M27.5 24l-8.3-8.6"/></svg>
          </span><span>E-Mail</span>
        </a>
        <a href="{{ card.website }}" target="_blank" rel="noopener" class="dbc-action" aria-label="Website">
          <span class="dbc-round" aria-hidden="true">
            <svg viewBox="0 0 32 32"><circle cx="16" cy="16" r="12.5"/><path d="M3.8 16h24.4M5.8 10.2h20.4M5.8 21.8h20.4"/><path d="M16 3.5c3 3.2 4.7 7.6 4.7 12.5S19 25.3 16 28.5M16 3.5c-3 3.2-4.7 7.6-4.7 12.5S13 25.3 16 28.5"/><path d="M16 3.5v25"/></svg>
          </span><span>Website</span>
        </a>
      </div>

      <div class="dbc-address">
        <span class="dbc-pin" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M16 29S6.5 19.1 6.5 11.8A9.5 9.5 0 0 1 25.5 11.8C25.5 19.1 16 29 16 29Z"/><circle cx="16" cy="12" r="3.1"/></svg></span>
        <div>{{ card.street }}<br>{{ card.postalCode }} {{ card.city }}{% if card.country %} · {{ card.country }}{% endif %}</div>
      </div>
      <div class="dbc-gold-line"></div>

      <h2>Unsere Marken</h2>
      <div class="dbc-brands">
        {% set configuredBrands = false %}
        {% for brand in brandSlots %}
          {% if brand.logo %}
            {% set configuredBrands = true %}
            {% if brand.url %}<a href="{{ brand.url }}" target="_blank" rel="noopener" class="dbc-brand">{% else %}<div class="dbc-brand">{% endif %}
              <img src="{{ brand.logo }}" alt="{{ brand.name ?: 'Marke' }}">
            {% if brand.url %}</a>{% else %}</div>{% endif %}
          {% endif %}
        {% endfor %}

        {% if not configuredBrands %}
          {% for brand in brands %}
            {% if brand.name|default('') != 'Eclipse Spa' %}
              <a href="{{ brand.url|default('#') }}" target="_blank" rel="noopener" class="dbc-brand">
                {% if brand.logoUrl %}<img src="{{ brand.logoUrl }}" alt="{{ brand.name|default('Marke') }}">{% else %}<span>{{ brand.name|default('Marke') }}</span>{% endif %}
              </a>
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>
    </div>

    <footer class="dbc-footer">
      <div class="dbc-claim"><i></i><span>{{ card.footerClaim ?: 'QUALITÄT FÜR GENERATIONEN' }}</span><i></i></div>
      <div class="dbc-legal">
        {% if card.imprintUrl %}<a href="{{ card.imprintUrl }}">Impressum</a>{% endif %}
        {% if card.imprintUrl and card.privacyUrl %}<span>|</span>{% endif %}
        {% if card.privacyUrl %}<a href="{{ card.privacyUrl }}">Datenschutz</a>{% endif %}
      </div>
    </footer>
  </section>
</main>
</body>
</html>
